# ==========================================
# ACME PORTAL - PRODUCTION ENV TEMPLATE
# ==========================================

# 1. Next.js Server Configuration
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# 2. Database Configuration (Production PostgreSQL / Supabase)
DATABASE_URL=postgresql://db_user:db_password@db_host:5432/db_name?schema=public

# 3. Google OAuth OIDC Keys
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# 4. NextAuth Credentials Configuration
# IMPORTANT: Generate a secure 32-character key using: openssl rand -base64 32
NEXTAUTH_SECRET=your-secure-nextauth-secret-key-32-chars
NEXTAUTH_URL=https://careers.yourdomain.com

# 5. AWS S3 Resume File Storage (us-west-1 region verified)
AWS_S3_REGION=us-west-1
AWS_S3_BUCKET_NAME=career-resumes
AWS_ACCESS_KEY_ID=your-production-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-production-iam-secret-access-key
# Custom storage provider endpoint parameters (e.g. Supabase, MinIO, R2) if applicable
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# 6. Rate Limiting Upstash Redis Credentials
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-secret

# 7. Scheduled Cron Security Bearer Token
CRON_SECRET=your-production-secure-cron-secret-token-xyz

# 8. Authorized HR Manager Email List (comma-separated values)
ADMIN_EMAILS=hr-director@yourdomain.com,recruiting-team@yourdomain.com

# 9. SMTP Mail Server Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-smtp-password-api-key
SMTP_FROM="Acme Enterprise Careers" <careers@yourdomain.com>
