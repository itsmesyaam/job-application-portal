# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth Configuration
# Run: openssl rand -base64 32 to generate a secure secret key
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL Database Configuration (Prisma Connection URL)
DATABASE_URL=postgresql://janedoe:mypassword@localhost:5432/career_db?schema=public

# AWS S3 or S3-Compatible File Storage Configuration
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=career-resumes
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
# Custom storage endpoint configurations (e.g. Supabase, MinIO, Cloudflare R2)
AWS_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
AWS_S3_FORCE_PATH_STYLE=true

# Authorized Admin Emails (comma-separated list for dashboard access)
ADMIN_EMAILS=admin@example.com,jane.doe@example.com

# Cron Job Authorization Token
CRON_SECRET=your-cron-secret-token

# SMTP Email Configuration (Optional - Falls back to Server Console Logs if empty)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com

# Firebase Client Credentials (Publicly accessible but prefix with NEXT_PUBLIC)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-app-id
